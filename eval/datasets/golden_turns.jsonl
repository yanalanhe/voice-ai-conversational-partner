{"id": "zh_hsk-rescheduling_appointment-hsk1-015", "pack": "zh_hsk", "level": "HSK1", "scenario": "rescheduling_appointment", "history": [["assistant", "你好，请问有什么可以帮您？"], ["user", "我想改时间。"], ["assistant", "好的，您想改到什么时候？"], ["user", "明天下午三点可以吗？"], ["assistant", "可以，没问题。"]], "learner_utterance": "对不起，我不能来。", "expected_behavior": "Simple, accommodating HSK1-level response to the cancellation.", "human_labels": {"level_appropriateness": 4, "corrective_feedback_quality": 4, "task_progression": 2, "conversational_naturalness": 3, "language_persona_fidelity": 4, "groundedness_safety": 4}}
